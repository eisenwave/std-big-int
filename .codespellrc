[codespell]
# Proper nouns / algorithm names codespell would otherwise mis-flag.
# - toom: Andrei Toom (Toom-Cook multiplication algorithm) -> not "tomb"
# - ser: IEEE citation format abbreviation for "series"
# - vEw: From the package-lock.json
# - statics: Static memory contents
ignore-words-list = toom,ser,vEw,statics
